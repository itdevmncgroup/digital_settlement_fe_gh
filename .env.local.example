# Relative path - Next.js rewrites (next.config.js) proxy this to BACKEND_URL,
# so the browser only ever hits this app's own port (3001). Use an absolute
# URL here instead only if you want the browser calling the backend directly.
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_URL=http://localhost:3000
# Idle session timeout, in minutes. 0 disables auto-logout entirely.
NEXT_PUBLIC_SESSION_TIMEOUT=30
